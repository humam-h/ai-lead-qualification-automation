    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH candidates AS (\n    SELECT id\n    FROM leads\n    WHERE followup_status = 'send_failed'\n      AND followup_retry_count < 3\n      AND (\n          followup_last_attempt_at IS NULL\n          OR followup_retry_count = 0\n          OR (\n              followup_retry_count = 1\n              AND followup_last_attempt_at <= NOW() - INTERVAL '10 minutes'\n          )\n          OR (\n              followup_retry_count = 2\n              AND followup_last_attempt_at <= NOW() - INTERVAL '30 minutes'\n          )\n      )\n    ORDER BY id\n    LIMIT 10\n    FOR UPDATE SKIP LOCKED\n)\nUPDATE leads AS l\nSET\n    followup_status = 'retrying',\n    followup_retry_count = l.followup_retry_count + 1,\n    followup_last_attempt_at = NOW()\nFROM candidates AS c\nWHERE l.id = c.id\nRETURNING\n    l.id,\n    l.email,\n    l.followup_subject,\n    l.followup_email,\n    l.followup_status,\n    l.followup_retry_count,\n    l.followup_last_attempt_at,\n    l.followup_error,\n    l.idempotency_key;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
